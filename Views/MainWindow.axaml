<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:withocr.ViewModels"
        x:Class="withocr.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="withocr"
        Width="800"
        Height="600"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="16">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,12">

            <StackPanel Orientation="Horizontal"
                        Spacing="8">

                <Button Command="{Binding OpenImageCommand}"
                        Content="打开图片" />

                <Button Command="{Binding PasteImageCommand}"
                        Content="从剪贴板读取" />

                <Button Command="{Binding OpenSettingsCommand}"
                        Content="设置" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">

            <Border Grid.Column="0"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                    Background="{DynamicResource ThemeControlAltHighBrush}"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnDragOver"
                    DragDrop.Drop="OnDrop"
                    >

                <Grid RowDefinitions="*,Auto">

                    <Border Grid.Row="0"
                            Background="{DynamicResource ThemeBackgroundBrush}">

                        <Grid>
                            <Image Source="{Binding Image}"
                                   Stretch="Uniform"
                                   IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}">

                                <TextBlock Text="将图片拖到这里"
                                           FontSize="22"
                                           HorizontalAlignment="Center" />

                                <TextBlock Text="或点击上方按钮选择图片"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                            </StackPanel>

                            <ProgressBar IsIndeterminate="True"
                                         VerticalAlignment="Bottom"
                                         IsVisible="{Binding IsBusy}"
                                         Margin="12" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               Text="支持 PNG、JPG、JPEG、BMP、GIF、WEBP、TIFF"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeControlBorderBrush}">

                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="OCR 结果"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Command="{Binding CopyTextCommand}"
                                Content="复制" />
                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding OcrText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             VerticalContentAlignment="Top"
                             Padding="10" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="Tesseract 语言：chi_sim+eng"
                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
    </Grid>
</Window>